# === Database & Cache ===
DB_PASSWORD=SuperSecretPassword123!
REDIS_PASSWORD=SuperSecretRedisPass123!

# === JWT & Security ===
JWT_SECRET=change-this-to-a-very-long-random-string-256-bits-minimum

# === Storage (choose one) ===
STORAGE_PROVIDER=azure          # s3 | wasabi | azure | r2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
