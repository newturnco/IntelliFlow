AZURE_STORAGE_ACCOUNT_NAME=yourazureaccount
AZURE_STORAGE_ACCOUNT_KEY=yourazurekey
AZURE_STORAGE_CONTAINER=intelliflow-crm

# === AI ===
OPENAI_API_KEY=sk-...
GROK_API_KEY=gsk-...          # optional (xAI)
ANTHROPIC_API_KEY=...         # optional

# === Domain (for production) ===
NEXT_PUBLIC_API_URL=https://api.your-domain.com